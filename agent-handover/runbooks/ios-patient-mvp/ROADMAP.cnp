validation.request id="validation.G08.V04" owner="measurement_owner" action="verify_declared_criterion" intent="A method change cannot silently present the same measurement-method version or turn simulation success into clinical accuracy." scope="G08" language="mixed" module="PhysioAssist" source_path="agent-handover/runbooks/ios-patient-mvp/validation-matrix.json" target="G08.V04" profile="reference_measurement_and_physical_device"
validation.predicate id="predicate.G08.V04" dod="dod.G08" validation_ref="validation.G08.V04" claim_ref="claim.G08" claim_kind="declared_gate_outcome" predicate="G08.V04" oracle_kind="reference_measurement_and_physical_device" oracle_state_root="not_observed" contract_ref="validation-matrix.json#G08.V04" expected_observation="criterion_holds_with_positive_and_negative_controls" claim_ceiling="declared_expectation_not_executed"
