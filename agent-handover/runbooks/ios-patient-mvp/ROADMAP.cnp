validation.request id="validation.G08.V06" owner="measurement_owner" action="verify_declared_criterion" intent="Repeated phone positioning and between-day reference comparisons separate setup bias, within-session variance and clinically meaningful change. Include stand movement, mattress compression, mirrored sides, initial prescribed roll, assistance and partial occlusion; rebaseline camera movement rather than label it patient drift. Match the initial upper-arm/torso setup across days as well as within-session drift. A session baseline must catch cumulative elbow migration that per-repetition resetting hides. Include pure rotation, combined shoulder/elbow translation and camera/torso motion controls." scope="G08" language="mixed" module="PhysioAssist" source_path="agent-handover/runbooks/ios-patient-mvp/validation-matrix.json" target="G08.V06" profile="reference_measurement_and_physical_device"
validation.predicate id="predicate.G08.V06" dod="dod.G08" validation_ref="validation.G08.V06" claim_ref="claim.G08" claim_kind="declared_gate_outcome" predicate="G08.V06" oracle_kind="reference_measurement_and_physical_device" oracle_state_root="not_observed" contract_ref="validation-matrix.json#G08.V06" expected_observation="criterion_holds_with_positive_and_negative_controls" claim_ceiling="declared_expectation_not_executed"
validation.request id="validation.G08.V07" owner="measurement_owner" action="verify_declared_criterion" intent="Chosen endpoint with poor tracking is withheld even if the rest of the session has high visibility. Pair the endpoint IR with elbow displacement and upper-arm direction from that same interval, not independent maxima/minima. Preserve numerical values/units/coverage through history, including held Checks; below-alert observations do not disappear into the warning list." scope="G08" language="mixed" module="PhysioAssist" source_path="agent-handover/runbooks/ios-patient-mvp/validation-matrix.json" target="G08.V07" profile="reference_measurement_and_physical_device"
