#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-push checks..."

# Type check (focused on core biomechanics code)
echo "⚡ TypeScript type checking (biomechanics & testing)..."
npx tsc --noEmit --project tsconfig.prepush.json || exit 1

# Run tests (Integration tests - core biomechanics validation)
echo "🧪 Running Integration tests..."
npm test -- src/testing/__tests__/Integration.test.ts --passWithNoTests || exit 1

echo "✅ Pre-push checks passed!"
